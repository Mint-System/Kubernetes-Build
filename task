# GitOps Commands

list-clusters() {
    if test -z "$1"; then echo '$1/path is empty.'; exit; fi
    local path="$1"
    local -a rows
    local max_name=4 max_alias=5 max_base=4

    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        local name=$(yq eval '.name' "$file" 2>/dev/null)
        local alias=$(basename "$(dirname "$file")")
        local base=$(basename "$file" .yaml)
        [[ -z "$name" ]] && name="(not set)"
        [[ -z "$alias" ]] && alias="(not set)"

        rows+=("$name|$alias|$base")

        (( ${#name} > max_name )) && max_name=${#name}
        (( ${#alias} > max_alias )) && max_alias=${#alias}
        (( ${#base} > max_base )) && max_base=${#base}
    done < <(grep -rl "^kind: Cluster$" "$path" 2>/dev/null)

    [[ ${#rows[@]} -eq 0 ]] && {
        echo "No cluster files found."
        return
    }

    printf '| %-*s | %-*s | %-*s |\n' \
        "$max_name" "Name" \
        "$max_alias" "Alias" \
        "$max_base" "Cname"

    printf '|-%*s-|-%*s-|-%*s-|\n' \
        "$max_name" "$(printf '%*s' "$max_name" '' | tr ' ' '-')" \
        "$max_alias" "$(printf '%*s' "$max_alias" '' | tr ' ' '-')" \
        "$max_base" "$(printf '%*s' "$max_base" '' | tr ' ' '-')"

    printf '%s\n' "${rows[@]}" | sort | while IFS='|' read -r name alias base; do
        printf '| %-*s | %-*s | %-*s |\n' \
            "$max_name" "$name" \
            "$max_alias" "$alias" \
            "$max_base" "$base"
    done
}

list-releases() {
    if test -z "$1"; then echo '$1/path is empty.'; exit; fi
    local path="$1"
    local -a rows
    local max_namespace=9 max_cluster=7 max_chart=5

    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        local dir_path
        dir_path=$(dirname "$file")
        local parent
        parent=$(basename "$(dirname "$dir_path")")
        local cluster
        local rel_path="${dir_path#./}"
        rel_path="${rel_path%/}"
        if [[ "$rel_path" == "$path/"* ]]; then
            cluster=$(echo "${rel_path#$path/}" | cut -d'/' -f1)
        else
            cluster=$(echo "$rel_path" | cut -d'/' -f1)
        fi
        [[ -z "$cluster" ]] && cluster="(unknown)"

        local namespace
        local chart
        if [[ "$parent" == "projects" ]]; then
            namespace=$(basename "$dir_path")
            chart=$(yq eval '.chart' "$file" 2>/dev/null)
            [[ "${chart}" == "null" || -z "$chart" ]] && chart=$(basename "$dir_path")
        elif [[ "$parent" == "base" ]]; then
            namespace=$(basename "$dir_path")
            chart=$(basename "$dir_path")
        else
            namespace=$(basename "$dir_path")
            chart=$(yq eval '.chart' "$file" 2>/dev/null)
            [[ "${chart}" == "null" || -z "$chart" ]] && chart=$(basename "$dir_path")
        fi

        rows+=("$namespace|$cluster|$chart")

        (( ${#namespace} > max_namespace )) && max_namespace=${#namespace}
        (( ${#cluster} > max_cluster )) && max_cluster=${#cluster}
        (( ${#chart} > max_chart )) && max_chart=${#chart}
    done < <(grep -rl "^kind: Release$" "$path" 2>/dev/null)

    [[ ${#rows[@]} -eq 0 ]] && {
        echo "No release files found."
        return
    }

    printf '| %-*s | %-*s | %-*s |\n' \
        "$max_namespace" "Namespace" \
        "$max_cluster" "Cluster" \
        "$max_chart" "Chart"

    printf '|-%*s-|-%*s-|-%*s-|\n' \
        "$max_namespace" "$(printf '%*s' "$max_namespace" '' | tr ' ' '-')" \
        "$max_cluster" "$(printf '%*s' "$max_cluster" '' | tr ' ' '-')" \
        "$max_chart" "$(printf '%*s' "$max_chart" '' | tr ' ' '-')"

    printf '%s\n' "${rows[@]}" | sort | while IFS='|' read -r namespace cluster chart; do
        printf '| %-*s | %-*s | %-*s |\n' \
            "$max_namespace" "$namespace" \
            "$max_cluster" "$cluster" \
            "$max_chart" "$chart"
    done
}

list-kubeconfigs() {
    if test -z "$1"; then echo '$1/path is empty.'; exit; fi
    local path="$1"
    local -a rows
    local max_name=4 max_path=4

    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        local name
        name=$(basename "$file")
        
        rows+=("$name|$file")

        (( ${#name} > max_name )) && max_name=${#name}
        (( ${#file} > max_path )) && max_path=${#file}
    done < <(find "$path" -path "*/.kube/config*.yaml" -type f 2>/dev/null | grep -v "\.decrypted$")

    [[ ${#rows[@]} -eq 0 ]] && {
        echo "No kubeconfig files found."
        return
    }

    printf '| %-*s | %-*s |\n' \
        "$max_name" "Name" \
        "$max_path" "Path"

    printf '|-%*s-|-%*s-|\n' \
        "$max_name" "$(printf '%*s' "$max_name" '' | tr ' ' '-')" \
        "$max_path" "$(printf '%*s' "$max_path" '' | tr ' ' '-')"

    printf '%s\n' "${rows[@]}" | sort | while IFS='|' read -r name path; do
        printf '| %-*s | %-*s |\n' \
            "$max_name" "$name" \
            "$max_path" "$path"
    done
}

switch-kubeconfig() {
    if test -z "$1"; then echo '$1/path is empty.'; exit; fi
    local target="$1"

    if [[ ! -f "$target" ]]; then
        echo "Error: Target config file '$target' does not exist." >&2
        return 1
    fi

    if grep -q "^sops:" "$target" 2>/dev/null; then
        decrypt-with-sops "$target" "decrypted"
        target="${target}.decrypted"
    fi

    mkdir -p "$HOME/.kube"
    echo "Remove $HOME/.kube/config"
    rm -f "$HOME/.kube/config" || true
    
    echo "Setup symlink from $HOME/.kube/config to $target"
    touch "$target"
    target="$(realpath "$target")"
    ln -s "$target" "$HOME/.kube/config"
    chmod 0644 "$target"

    local context_alias
    local parent_dir
    parent_dir=$(dirname "$1")
    context_alias=$(basename "$(dirname "$parent_dir")")

    local cluster_dir
    cluster_dir=$(dirname "$1")
    cluster_dir=$(dirname "$cluster_dir")
    local cluster_file=""
    for file in "$cluster_dir"/*.yaml; do
        if [[ "$(yq eval '.kind' "$file" 2>/dev/null)" == "Cluster" && "$(basename "$(dirname "$file")")" == "$context_alias" ]]; then
            cluster_file="$file"
            break
        fi
    done

    if [[ -n "$cluster_file" && "$(yq eval '.openshift' "$cluster_file" 2>/dev/null)" == "true" ]]; then
        local server
        server="$(kubectl config view -o jsonpath='{.clusters[0].cluster.server}')"
        echo "Login to OpenShift cluster"
        oc login --web --server="$server"
    fi

    if kubectl config current-context >/dev/null 2>&1; then
        echo 'Select namespace'
        select-kubectl-namespace
    fi
}

update-dependencies() {
    if test -z "$1"; then echo '$1 is empty.'; exit; fi
    helm dependency update "$1"
}

install-chart() {
    if test -z "$1"; then echo '$1 is empty.'; exit; fi
    if test -z "$2"; then echo '$2 is empty.'; exit; fi
    local release_name="$1"

    if [[ "$1" = 'cluster-issuer' ]]; then
        "install-$1" "$2"
    elif list-charts | grep -q "$1"; then
        echo "Install chart $1 as release $release_name:"
        helm install "$release_name" "$1" \
            --values "$2"
    elif list-external-charts | grep -q "$1"; then
        echo "Error: '$1' is an external chart. Use the explicit command 'install-$1' instead."
        echo "Run 'task help bootstrap' to list the bootstrap commands."
        exit 1
    else
        echo "Error: Unknown chart '$1'."
        echo "Run 'task list-charts' or 'task list-external-charts' to list available charts."
        exit 1
    fi
}

install-cnpg() {
    echo 'Install cnpg/cloudnative-pg.'
    helm upgrade --install cnpg \
      --namespace cnpg-system \
      --create-namespace \
      cnpg/cloudnative-pg
}

install-k8up() {
    echo 'Install k8up-io/k8up.'
    helm install k8up k8up-io/k8up \
        --create-namespace --namespace k8up
}

install-cert-manager() {
    echo 'Install jetstack/cert-manager.'
    helm install \
      cert-manager jetstack/cert-manager \
      --namespace cert-manager \
      --create-namespace \
      --version v1.18.2 \
      --set crds.enabled=true \
      --set config.featureGates.ACMEHTTP01IngressPathTypeExact=false

    # https://github.com/Infomaniak/cert-manager-webhook-infomaniak
    echo 'Apply Infomaniak webhook'
    kubectl apply -f https://github.com/Infomaniak/cert-manager-webhook-infomaniak/releases/download/v0.3.1/rendered-manifest.yaml
}

install-cluster-issuer() {
    echo 'Install clusterissuer.'
    helm install clusterissuer cluster-issuer \
        --namespace cert-manager \
        --values "$1"
}

install-traefik() {
    echo 'Install traefik/traefik.'
    helm install traefik traefik/traefik \
        --create-namespace --namespace traefik
}

install-metrics-server() {
    echo 'Install metrics-server/metrics-server.'
    local values_args=()
    if [[ -n "$1" ]]; then
        values_args+=(--values "$1")
    fi
    helm install metrics-server metrics-server/metrics-server \
        --create-namespace --namespace metrics-server \
        --set-json 'args=["--kubelet-insecure-tls"]' \
        "${values_args[@]}"
}

upgrade-release() {
    if test -z "$1"; then echo '$1 is empty.'; exit; fi
    if test -z "$2"; then echo '$2 is empty.'; exit; fi

    local release_name="$1"

    if list-charts | grep -q "$1"; then
        echo "Upgrade $1 chart for release $release_name:"
        helm upgrade "$release_name" "$1" \
            --values "$2"
    else
        "upgrade-$1" "$2"
    fi
}

upgrade-cert-manager() {
    echo 'Upgrade jetstack/cert-manager.'
    helm upgrade \
        cert-manager jetstack/cert-manager \
        --namespace cert-manager \
        --version v1.18.2 \
        --set crds.enabled=true \
        --set config.featureGates.ACMEHTTP01IngressPathTypeExact=false

    # https://github.com/Infomaniak/cert-manager-webhook-infomaniak
    echo 'Apply Infomaniak webhook'
    kubectl apply -f https://github.com/Infomaniak/cert-manager-webhook-infomaniak/releases/download/v0.3.1/rendered-manifest.yaml
}

upgrade-cluster-issuer() {
    echo 'Upgrade cluster-issuer.'
    helm upgrade \
        clusterissuer cluster-issuer \
        --namespace cert-manager \
        --values "$2"
}

uninstall-release() {
    if test -z "$1"; then echo '$1 is empty.'; exit; fi
    local release_name="$1"

    echo "Uninstall release $release_name:"

    local namespace=""
    case "$release_name" in
        cert-manager) namespace="cert-manager" ;;
        cnpg) namespace="cnpg-system" ;;
        k8up) namespace="k8up" ;;
        metrics-server) namespace="metrics-server" ;;
        traefik) namespace="traefik" ;;
    esac

    if [[ -n "$namespace" ]]; then
        helm uninstall "$release_name" --namespace "$namespace"
    else
        helm uninstall "$release_name"
    fi
}

uninstall-haproxy-ingress() {
    echo 'Uninstall ingress-nginx release.'
    helm uninstall haproxy-ingress/haproxy-ingress --namespace haproxy-ingress
    kubectl delete namespace haproxy-ingress
}

uninstall-ingress-nginx() {
    echo 'Uninstall ingress-nginx release.'
    helm uninstall ingress-nginx --namespace ingress-nginx
    kubectl delete namespace ingress-nginx
}

run-job() {
    if test -z "$1"; then echo '$1 is empty.'; exit 1; fi
    local job_name="$1"

    echo "Run job: $job_name"
    kubectl delete job ${job_name}-run --ignore-not-found
    kubectl create job --from=cronjob/${job_name} ${job_name}-run
}

# kubectl Commands

reveal-secrets() {
    if test -z "$1"; then echo '$1/name is empty.'; exit; fi

    kubectl get secret "$1" -o json | jq -r '.data | to_entries[] | "\(.key): \(.value | @base64d)"'
}


get-pods() {
    kubectl get pods
}

watch-cluster-memory() {
    if ! kubectl get --raw /apis/metrics.k8s.io/ &> /dev/null; then
        echo 'Error: Metrics API is not available.'
        echo 'Install metrics-server to enable pod memory stats.'
        return 1
    fi

    watch -n 2 'echo "=== Nodes ==="; kubectl top nodes; echo; echo "=== Pods ==="; kubectl top pods --all-namespaces | { read -r header; echo "$header"; sort -k4 -n -r; }'
}

# Helm Commands

template-manifest() {
    if test -z "$1"; then echo '$1 is empty.'; exit; fi
    if test -z "$2"; then echo '$2 is empty.'; exit; fi
    local release_name="$1"

    if [[ "$1" = 'cluster-issuer' ]]; then
        helm --debug template "$release_name" cluster-issuer \
            --namespace cert-manager \
            --values "$2" > manifest.yaml
    elif list-charts | grep -q "$1"; then
        helm --debug template "$release_name" "$1" \
            --values "$2"
    fi
}

list() {
    helm list
}

package-repo() {
    if [[ -n "$1" ]]; then
        echo "Package $1 Helm chart."
        helm package "$1" --destination docs/
    else
        echo 'Package all Helm charts.'
        update-dependencies odoo
        update-dependencies prometheus-agent
        rm -f docs/*.tgz
        for chart in $(list-charts); do
            helm package "$chart" --destination docs/
        done
        index-repo
    fi
}

commit() {
    git config user.name 'Mint Bot'
    git config user.email 'bot@mint-system.ch'
    git remote set-url origin "https://x-access-token:${GITHUB_TOKEN}@github.com/Mint-System/Kubernetes-Build"
    git add docs/*.tgz docs/index.yaml
    git commit -m 'feat(helm): package revision update'
    git push || echo 'No changes to commit'
}

index-repo() {
    echo 'Update docs/index.yaml'
    helm repo index docs/
}

add-repos(){
    echo 'Add kubernetes-build.'
    helm repo add kubernetes-build https://kubernetes.build

    echo 'Add jetstack.'
    helm repo add jetstack https://charts.jetstack.io

    echo 'Add cnpg.'
    helm repo add cnpg https://cloudnative-pg.github.io/charts

    echo 'Add k8up.'
    helm repo add k8up-io https://k8up-io.github.io/k8up

    echo 'Add metrics-server.'
    helm repo add metrics-server https://kubernetes-sigs.github.io/metrics-server

    echo 'Add traefik.'
    helm repo add traefik https://helm.traefik.io/traefik
}

remove-repo(){
    echo 'Remove the kubernetes-build repo.'
    helm repo remove kubernetes-build
}

# Docs Commands

docs() {
    for repo in $(list-charts | grep -v '^deployment-updater$'); do
        pnpm run generate-readme --values "$repo/values.yaml" -r "$repo/README.md"
    done
}

lint() {
    for chart in $(list-charts); do
        helm lint "$chart"
    done
}

if [[ "$1" == *","* ]]; then
    # Split comma-separated commands
    IFS=',' read -ra COMMANDS <<< "$1"
    for cmd in "${COMMANDS[@]}"; do
        # Trim whitespace
        cmd=$(echo "$cmd" | xargs)
        if declare -f "$cmd" > /dev/null; then
            "$cmd"
        else
            echo "Unknown command: $cmd"
            help "$@"
            exit 1
        fi
    done
elif declare -f "$1" > /dev/null; then
    if [[ "${2:-}" == "tfhelp" ]]; then
        help "$1"
    else
        "$1" "${@:2}"
    fi
else
    case "$1" in
        *)
            echo "Unknown command: $1"
            exit 1
            ;;
    esac
fi
