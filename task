#!/usr/bin/env bash
set -e

if [[ -f ".env" ]]; then
    # shellcheck source=/dev/null
    source ".env"
fi

help-table() {
    local -a rows
    local max_cmd=7 max_opt=6 max_desc=11

    rows+=("Command|Option|Description")
    rows+=("===ENV===| | ")
    rows+=("version||Show version of required tools.")
    rows+=("info||Show info about env.")
    rows+=("template-dotenv||Generate .env from .env.template.")
    rows+=("===DOCS===| | ")
    rows+=("init-zensical-docs||Initialize Zensical documentation build dependencies.")
    rows+=("dev-zensical-docs||Run Zensical development server.")
    rows+=("build-zensical-docs||Build the Zensical documentation website.")
    rows+=("serve-zensical-docs||Serve the Zensical documentation build folder.")
    rows+=("===HOST===| | ")
    rows+=("start||Start kind Kubernetes cluster.")
    rows+=("start-and-prepare||Start and prepare Kubernetes cluster.")
    rows+=("load-image|[tag]|Load Docker image into kind cluster.")
    rows+=("delete-kind||Delete kind Kubernetes cluster.")
    rows+=("setup-hosts||Update hosts file.")
    rows+=("forward|[chart]|Forward port.")
    rows+=("===CHART===| | ")
    rows+=("list-charts||List local Helm charts.")
    rows+=("list-external-charts||List external Helm charts.")
    rows+=("update-dependencies|[chart]|Update dependencies for a chart.")
    rows+=("install-chart|[chart][values]|Install local Helm chart.")
    rows+=("upgrade-release|[chart][values]|Upgrade Helm release.")
    rows+=("uninstall-release|[release]|Uninstall Helm release.")
    rows+=("===BOOTSTRAP===| | ")
    rows+=("install-cert-manager||Install cert-manager with Infomaniak webhook.")
    rows+=("install-cluster-issuer|[values]|Install cluster-issuer chart.")
    rows+=("install-cnpg||Install CloudNativePG operator.")
    rows+=("install-k8up||Install k8up backup operator.")
    rows+=("install-metrics-server|[values]|Install metrics-server.")
    rows+=("install-traefik||Install traefik ingress controller.")
    rows+=("===GITOPS===| | ")
    rows+=("list-clusters|<path>|List clusters.")
    rows+=("list-releases|<path>|List releases.")
    rows+=("get-cluster||Show active cluster.")
    rows+=("===KUBECONFIG===| | ")
    rows+=("generate-kubconfig|<sa><path>|Generate kubeconfig for service account.")
    rows+=("list-kubeconfigs|<path>|List kubeconfig files.")
    rows+=("switch-kubeconfig|<path>|Switch kubeconfig file.")
    rows+=("get-kubeconfig||Show active kubeconfig.")
    rows+=("===KUBECTL===| | ")
    rows+=("reveal-secrets|<name>|Show base64 decoded secret content.")
    rows+=("list||List Helm releases.")
    rows+=("get-pods||List all pods.")
    rows+=("get-namespace||Show active namespace.")
    rows+=("login-oc||Refresh the auth token for OpenShift.")
    rows+=("run-job|[name]|Make a copy of job.")
    rows+=("watch-cluster-memory||Watch memory consumption of pods.")
    rows+=("===HELM===| | ")
    rows+=("docs||Generate Helm chart readmes.")
    rows+=("lint||Lint Helm charts.")
    rows+=("add-repos||Add the required Helm repos.")
    rows+=("template-manifest|[chart][values]|Template all charts with Helm.")
    rows+=("package-repo|[chart]|Package Helm charts.")
    rows+=("index-repo||Index Helm chart.")
    rows+=("remove-repo||Remove the kubernetes-build repo.")
    rows+=("commit||Commit .tgz files.")
    rows+=("===TEST===| | ")
    rows+=("test-chart-cluster-issuer||Test cluster issuer.")
    rows+=("test-chart-odoo|[cleanup]|Setup Odoo chart and dependencies.")
    rows+=("test-chart-nextcloud|[cleanup]|Setup Nextcloud chart and dependencies.")
    rows+=("test-chart-remark42|[cleanup]|Setup Remark42 chart and dependencies.")

    for row in "${rows[@]}"; do
        IFS='|' read -r cmd opt desc <<< "$row"
        (( ${#cmd} > max_cmd )) && max_cmd=${#cmd}
        (( ${#opt} > max_opt )) && max_opt=${#opt}
        (( ${#desc} > max_desc )) && max_desc=${#desc}
    done

    printf '| %-*s | %-*s | %-*s |\n' \
        "$max_cmd" "Command" \
        "$max_opt" "Option" \
        "$max_desc" "Description"

    printf '|-%*s-|-%*s-|-%*s-|\n' \
        "$max_cmd" "$(printf '%*s' "$max_cmd" '' | tr ' ' '-')" \
        "$max_opt" "$(printf '%*s' "$max_opt" '' | tr ' ' '-')" \
        "$max_desc" "$(printf '%*s' "$max_desc" '' | tr ' ' '-')"

    local first_row=true
    for row in "${rows[@]:1}"; do
        IFS='|' read -r cmd opt desc <<< "$row"
        if [[ "$cmd" =~ ^===.*===$ ]]; then
            group_name="${cmd/===/}"
            group_name="${group_name/===/}"
            
            if [ "$first_row" = true ]; then
                first_row=false
            else
                printf '|-%*s-|-%*s-|-%*s-|\n' \
                    "$max_cmd" "$(printf '%*s' "$max_cmd" '' | tr ' ' '-')" \
                    "$max_opt" "$(printf '%*s' "$max_opt" '' | tr ' ' '-')" \
                    "$max_desc" "$(printf '%*s' "$max_desc" '' | tr ' ' '-')"
            fi
            
            local left_pad=$(( (max_cmd - ${#group_name}) / 2 ))
            local right_pad=$(( max_cmd - left_pad - ${#group_name} ))
            printf '| %*s%s%*s | %*s | %*s |\n' \
                "$left_pad" "" \
                "$group_name" \
                "$right_pad" "" \
                "$max_opt" "" \
                "$max_desc" ""
            
            printf '|-%*s-|-%*s-|-%*s-|\n' \
                "$max_cmd" "$(printf '%*s' "$max_cmd" '' | tr ' ' '-')" \
                "$max_opt" "$(printf '%*s' "$max_opt" '' | tr ' ' '-')" \
                "$max_desc" "$(printf '%*s' "$max_desc" '' | tr ' ' '-')"
        else
            first_row=false
            printf '| %-*s | %-*s | %-*s |\n' \
                "$max_cmd" "$cmd" \
                "$max_opt" "$opt" \
                "$max_desc" "$desc"
        fi
    done
}

help() {
    local grep_pattern
    echo
    if [[ -n "$1" ]]; then
        grep_pattern="$1"
        help-table | grep -i "$grep_pattern" | column -t -s'|'
    else
        echo "task <command> [options]"
        echo
        echo "commands:"
        echo
        help-table
    fi
    echo
}

